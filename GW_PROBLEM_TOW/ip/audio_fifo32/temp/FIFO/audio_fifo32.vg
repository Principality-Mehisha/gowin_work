output Almost_Full;
output [31:0] Q;
output Empty;
output Full;
wire VCC;
wire GND;
  \~fifo.Gowin_Audio_FIFO32  fifo_inst (
    .RdClk(RdClk),
    .RdReset(RdReset),
    .WrClk(WrClk),
